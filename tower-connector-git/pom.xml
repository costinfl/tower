<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.tower</groupId>
    <artifactId>tower-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tower-connector-git</artifactId>
  <name>tower-connector-git</name>

  <!--
    The Source Control Connector (issue #3, ADR-014).

    JGit rather than a vendor SDK, and rather than shelling out to the git
    binary. ADR-014 records the reasoning: refs are git concepts, so one
    implementation serves GitHub, GitLab, Bitbucket, a self-hosted server and a
    bare repository on a file share. JGit keeps that in-process, with no external
    executable to find and no command line to quote.

    Only reference discovery is used. Nothing here clones or fetches objects.
  -->
  <dependencies>
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
      <version>${jgit.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-connector-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
