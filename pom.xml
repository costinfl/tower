<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.tower</groupId>
  <artifactId>tower-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>tower-parent</name>
  <description>Tower — a developer-centric command center for software delivery</description>

  <!--
    Spring Boot is imported through dependencyManagement rather than inherited as a
    parent POM. This is deliberate: it lets tower-domain remain free of framework
    dependencies, which is what makes NFR-004, NFR-005 and NFR-006 enforceable rather
    than aspirational. See docs/planning/Implementation-Plan.md.
  -->

  <modules>
    <module>tower-domain</module>
    <module>tower-application</module>
    <module>tower-collector</module>
    <module>tower-connector-api</module>
    <module>tower-connector-manual</module>
    <module>tower-connector-git</module>
    <module>tower-connector-k8s</module>
    <module>tower-connector-github</module>
    <module>tower-persistence</module>
    <module>tower-config</module>
    <module>tower-docgen</module>
    <module>tower-portability</module>
    <module>tower-api</module>
    <module>tower-web</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <spring-boot.version>3.4.1</spring-boot.version>
    <archunit.version>1.3.0</archunit.version>
    <jasypt.version>3.0.5</jasypt.version>
    <!-- openshift-client is a superset of kubernetes-client: it reads plain Kubernetes
         resources and OpenShift's own DeploymentConfig from one dependency. -->
    <fabric8.version>6.13.4</fabric8.version>
    <!-- Reference discovery only, for the Source Control Connector (ADR-014). JGit
         rather than a vendor SDK, so one connector reads GitHub, GitLab, Bitbucket
         and a bare repository alike. -->
    <jgit.version>7.1.0.202411261347-r</jgit.version>
    <frontend-plugin.version>1.15.1</frontend-plugin.version>
    <node.version>v22.23.1</node.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.ulisesbocchio</groupId>
        <artifactId>jasypt-spring-boot-starter</artifactId>
        <version>${jasypt.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>${frontend-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!--
            spring-boot-starter-parent sets -parameters by default. We import the
            Spring Boot BOM instead of inheriting that parent, so we must set it
            ourselves: without retained parameter names, an unnamed @PathVariable
            or @RequestParam compiles cleanly and then fails at request time.
            That is a latent trap for every controller written from here on.
          -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
    </plugins>
  </build>
</project>
