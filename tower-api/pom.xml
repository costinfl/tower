<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.tower</groupId>
    <artifactId>tower-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tower-api</artifactId>
  <name>tower-api</name>

  <dependencies>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-collector</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-connector-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-connector-manual</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-persistence</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-config</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-docgen</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-portability</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      The Viewer is packaged as static content inside the tower-web jar
      (META-INF/resources). Depending on it here is what makes a single
      `mvn spring-boot:run` serve both the API and the user interface,
      which is the clone-build-run goal in ADR-009.
    -->
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-web</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Version and configuration inherited from the root pom's pluginManagement. -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
