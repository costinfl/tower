<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.tower</groupId>
    <artifactId>tower-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tower-api</artifactId>
  <name>tower-api</name>

  <dependencies>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      tower-api is the composition root. It compiles against the domain and
      the application ports above and against nothing else Tower-owned.

      Every adapter below is runtime scope on purpose: Spring needs them on
      the classpath to wire, but the compiler will reject any attempt to
      import an adapter type from this module. That makes the layering a
      structural fact rather than a convention a reviewer has to police, and
      the architecture tests in src/test back it up.

      tower-web carries no Java at all. It is the built Viewer packaged as
      static content under META-INF/resources, and depending on it here is
      what lets a single `mvn spring-boot:run` serve both the API and the
      user interface (ADR-009, clone-build-run).
    -->
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-collector</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-connector-api</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-connector-manual</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-persistence</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-config</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!--
      tower-docgen is compile scope, unlike the adapters above. It is not an
      adapter: it reaches no external system and sits above the application
      ports, reading the Canonical Model exactly as a controller would. Keeping
      it compile scope lets the composition root wire it explicitly and lets
      tower-docgen stay free of Spring, which suits a deterministic renderer
      that is otherwise a pure function.
    -->
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-docgen</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-portability</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.tower</groupId>
      <artifactId>tower-web</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Version and configuration inherited from the root pom's pluginManagement. -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
