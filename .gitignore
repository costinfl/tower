# Build output
target/
dist/
node_modules/

# frontend-maven-plugin used to install its Node/npm here. It now installs into
# tower-web/target/, which target/ above already covers, so this path is only
# ever an orphan left in a checkout that predates that change. Kept ignored so
# nobody commits one; safe to delete by hand.
/tower-web/node/

# Application data lives in ~/.tower and must never enter the repository.
# ADR-009 keeps it outside the working tree; these rules are defence in depth.
.tower/
*.mv.db
*.trace.db
config.yml
application-local.yml
application-local.properties
.env

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
